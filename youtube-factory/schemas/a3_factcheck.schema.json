{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "a3_factcheck.schema.json",
  "title": "A3FactCheckPayload",
  "description": "A3事実・法務監査の出力。設計書§7の必須ゲート。根拠のない制度・税率・金額・期限・法律上の断定は公開禁止。verdict=OK が1つでも欠ければ gate_passed は false。",
  "type": "object",
  "required": ["ep", "checked_at", "gate_passed", "claims"],
  "additionalProperties": false,
  "properties": {
    "ep": { "type": "integer" },
    "checked_at": { "type": "string", "format": "date" },
    "gate_passed": { "type": "boolean" },
    "reviewer": { "type": "string", "description": "A3 または人間監査者" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "claim", "verdict"],
        "properties": {
          "claim_id": { "type": "string", "description": "例: C01" },
          "claim": { "type": "string", "description": "動画内で述べる主張" },
          "source": { "type": "string", "description": "出典URL/資料名" },
          "publisher": { "type": "string", "description": "発行主体" },
          "confirmed_at": { "type": "string", "format": "date", "description": "最終確認日" },
          "location": { "type": "string", "description": "ページ/見出し等 該当箇所" },
          "verdict": { "type": "string", "enum": ["OK", "要修正", "未確認"] },
          "risk": { "type": "string", "enum": ["low", "medium", "high"], "description": "断定の影響度。制度/税率/金額/期限/法律は high 扱い。" },
          "comment": { "type": "string" }
        }
      }
    }
  }
}

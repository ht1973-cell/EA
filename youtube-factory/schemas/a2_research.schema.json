{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "a2_research.schema.json",
  "title": "A2ResearchPayload",
  "description": "A2調査エージェントの出力。台本の各主張を裏付ける一次情報リンク集。",
  "type": "object",
  "required": ["ep", "topic", "sources", "collected_at"],
  "additionalProperties": false,
  "properties": {
    "ep": { "type": "integer" },
    "topic": { "type": "string" },
    "collected_at": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_ref", "title", "url", "publisher", "primary"],
        "properties": {
          "claim_ref": { "type": "string", "description": "対応するclaim_id (例: C01)" },
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "publisher": { "type": "string", "description": "発行主体（国税庁/金融庁/厚労省/日銀 等）" },
          "primary": { "type": "boolean", "description": "一次情報ならtrue" },
          "quote": { "type": "string", "description": "根拠となる該当箇所の引用" },
          "retrieved_at": { "type": "string", "format": "date" }
        }
      }
    }
  }
}

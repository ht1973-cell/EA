# AI YouTube 制作工場 環境変数（コピーして .env に）
# ローカルパイプライン
FACTORY_ROOT=/home/user/EA/youtube-factory
# FFmpeg（未指定なら pip の imageio-ffmpeg 同梱バイナリを自動使用）
# FFMPEG=/usr/bin/ffmpeg
# FFPROBE=/usr/bin/ffprobe

# Notion
NOTION_DB_ID=798a4d93408f44b8a16acf9dde43c8fd

# ブラウザ自動操作（永続プロファイル：ログイン状態を保持）
CHROME_PROFILE_DIR=./profiles
# YouTube
YOUTUBE_CHANNEL=

# 公開安全弁（1=予約投稿直前で停止 / 0=承認済なら実公開）
DRY_RUN=1
